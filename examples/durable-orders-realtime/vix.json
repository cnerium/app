{
  "name": "durable-orders-realtime",
  "version": "0.1.0",
  "description": "Cnerium durable orders API with realtime WebSocket events.",
  "type": "example",
  "runtime": "vix",
  "framework": "cnerium",
  "entry": "src/main.cpp",
  "commands": {
    "build": "vix build",
    "run": "vix run",
    "dev": "vix dev"
  },
  "cnerium": {
    "data_dir": "data/cnerium",
    "node_id": "durable-orders-realtime-node",
    "realtime": {
      "enabled": true,
      "endpoint": "/ws",
      "host": "0.0.0.0",
      "port": 9090
    }
  },
  "http": {
    "host": "0.0.0.0",
    "port": 8080
  }
}

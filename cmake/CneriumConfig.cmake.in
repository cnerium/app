@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

# ========================
# Dependencies
# ========================

find_dependency(vix CONFIG)
find_dependency(sdk-cpp CONFIG)

# ========================
# Targets
# ========================

include("${CMAKE_CURRENT_LIST_DIR}/cneriumTargets.cmake")

# ========================
# Compatibility aliases
# ========================

if(TARGET cnerium::cnerium AND NOT TARGET softadastra::cnerium)
    add_library(softadastra::cnerium ALIAS cnerium::cnerium)
endif()

check_required_components(cnerium)
